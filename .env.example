# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，绝不提交。
# 项目约束：API key 一律走环境变量，不得硬编码、不得写进日志/数据库。

# ---- LLM（决策 D5，2026-08-28 执行调整）----
# D5 原定 DeepSeek-V3；跑 demo 阶段切智谱 GLM-4.7-Flash（官方免费，OpenAI SDK 兼容），
# 实测成本 $0，成本红线（单达人 < $0.1）不变。DeepSeek 作为付费备选保留在
# llm_service.MODEL_PRICING 价格表中，随时可切回——换厂商只改下面两行。
# 下面默认值填的正是当前实际在用的配置，不是占位符；
# 复制成 .env 后照抄即可跑通，只需自己去申请 LLM_API_KEY。
LLM_API_KEY=replace-me
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_TIMEOUT=60
# 分类任务要一致性，温度压低（设计文档 3.3②：0.1~0.3）
LLM_TEMPERATURE=0.2
# 坑（D5 执行调整记录）：免费档高峰期返回 429（错误码 1305「访问量过大」），
# llm_service 已把 OpenAI 客户端 max_retries 硬编码提到 6 次指数退避，这里不需要配

# ---- YouTube 数据源 ----
# yt-dlp 抓不到时降级用官方 Data API v3
YOUTUBE_API_KEY=replace-me

# ---- 网络代理（可选，本地直连 YouTube 失败时配）----
# 坑：IP 不通时字幕接口会误报「无字幕」，不是真的没字幕
HTTP_PROXY=
HTTPS_PROXY=

# ---- 成本闸门（决策 D5：单达人 < $0.1，月预算 < ¥100）----
# 超预算在发请求前直接拒绝，不许静默继续
MONTHLY_BUDGET_USD=15.0
PER_CHANNEL_BUDGET_USD=0.1

# ---- 本地 ASR 兜底（决策 B2：faster-whisper）----
# 只在公开字幕 API 拿不到时降级走本地转写；模型首次使用才下载，之后离线可跑
WHISPER_ENABLED=1
WHISPER_MODEL=small          # 英文为主 small 足够；中英混说别用 .en 单语版
WHISPER_LANGUAGE=            # 留空 = 自动检测
WHISPER_DEVICE=auto          # 有 CUDA 显卡走显卡，没有自动落 CPU
WHISPER_COMPUTE_TYPE=auto

# ---- 存储 ----
DATABASE_URL=sqlite:///./kol_analysis.db
ANALYSIS_BUDGET_USD=0.1
ANALYSIS_FRESH_TTL_HOURS=24

# SOCKS5 proxy for YouTube captions (online / blocked cloud IPs). Prefer socks5h.
# ALL_PROXY=socks5h://USER:PASS@HOST:PORT
# CAPTIONS_ENABLED=true
# WHISPER_ENABLED=false
