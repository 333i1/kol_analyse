# Copy to .env and fill in real values. Do not commit .env.
# Keep API keys in environment variables only (never hardcode or log them).

# ---- LLM ----
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_INTER_CALL_DELAY_S=1.5
LLM_INPUT_USD_PER_1K=0.00015
LLM_OUTPUT_USD_PER_1K=0.0006

# ---- YouTube ----
# Used when yt-dlp alone is not enough (Data API v3)
YOUTUBE_API_KEY=your-youtube-api-key

# ---- Optional HTTP(S) proxy ----
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
# Data API only; leave empty for direct. Captions use ALL_PROXY / CAPTION_PROXIES.
YOUTUBE_API_PROXY=

# ---- Caps / budgets ----
ANALYSIS_BUDGET_USD=0.1
ANALYSIS_FRESH_TTL_HOURS=24
MONTHLY_BUDGET_USD=15.0
PER_CHANNEL_BUDGET_USD=0.1

# ---- Captions & local ASR fallback ----
CAPTIONS_ENABLED=true
WHISPER_ENABLED=1
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
STT_USD_PER_MINUTE=0.0

# Caption egress (optional)
CAPTION_EGRESS=static
CAPTION_PROXIES=
CAPTION_CONCURRENCY=1
CAPTION_MIN_INTERVAL_S=10.0
CAPTION_BACKOFF_S=90.0
CAPTION_JITTER_S=2.0

# ---- Storage / logging ----
# SQLITE_PATH defaults to backend/data/app.db when unset
# SQLITE_PATH=
LOG_LEVEL=INFO
