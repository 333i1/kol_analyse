{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kol.local/schema/video-analysis-result.schema.json",
  "title": "AnalysisResult",
  "description": "单视频分析 MVP 对外输出（AnalysisResult）。schema_version 恒为 1.0.0。禁止字段：selling_points、卖点、危机/适合合作结论槽、第四段广告 kind、Hook/主体/CTA 作为 segment_kind。cta_type 仅收束可非 null；开场/展开必须为 null。commercial 无植入时必须为 JSON null。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_version",
    "video",
    "task",
    "health",
    "metrics",
    "content_analysis",
    "comment_analysis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "result_version": {
      "type": "string",
      "minLength": 1,
      "description": "分析规则/模型结果版本，例如 schema1.0.0+content-v1+comments-v1+gpt-placeholder。夹具可用 fixture-EXAMPLE。"
    },
    "is_fixture": {
      "type": "boolean",
      "description": "黄金夹具为 true。生产路径必须为 false 或省略。"
    },
    "fixture_note": {
      "type": "string"
    },
    "video": {
      "$ref": "#/definitions/video"
    },
    "task": {
      "$ref": "#/definitions/task"
    },
    "health": {
      "$ref": "#/definitions/health"
    },
    "contrast_summary": {
      "description": "对照总述，可选。双管线均失败时可省略。出现时 freshness_tags 与 fetched_at_label 必填。",
      "$ref": "#/definitions/contrast_summary"
    },
    "metrics": {
      "$ref": "#/definitions/metrics"
    },
    "content_analysis": {
      "$ref": "#/definitions/content_analysis"
    },
    "comment_analysis": {
      "$ref": "#/definitions/comment_analysis"
    }
  },
  "definitions": {
    "health_level": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "failed"
      ]
    },
    "pipeline_status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "failed"
      ]
    },
    "video_type": {
      "type": "string",
      "enum": [
        "教程",
        "评测",
        "日常",
        "观点",
        "资讯",
        "娱乐",
        "游戏",
        "音乐",
        "影视解说",
        "体育",
        "喜剧",
        "其他"
      ]
    },
    "tone": {
      "type": "string",
      "enum": [
        "解说",
        "吐槽",
        "陪伴",
        "严肃",
        "表演",
        "论证",
        "其他"
      ]
    },
    "segment_kind": {
      "type": "string",
      "enum": [
        "开场",
        "展开",
        "收束"
      ],
      "description": "唯一合法结构段。禁止 Hook / 主体 / CTA / 广告。"
    },
    "cta_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "关注",
        "下一集",
        "投票",
        "购买",
        "收藏",
        "评论",
        "其他",
        null
      ],
      "description": "CTA 只允许出现在收束段。开场/展开必须为 null。本 Schema 允许任意段为 null；非收束出现非 null 视为违规（由 segment.if/then 强制）。不要默认购买。"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "共鸣",
        "反驳",
        "提问",
        "纠错",
        "玩梗",
        "点名时间戳",
        "求更新",
        "分享经历",
        "其他"
      ]
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "正面",
        "中性",
        "负面"
      ]
    },
    "transcript_mode": {
      "type": "string",
      "enum": [
        "captions",
        "speech_to_text",
        "none"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "low_confidence": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.6,
      "description": "必须 < 0.6 才进入孤立低置信列表。"
    },
    "no_verdict": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "危机|适合合作"
      },
      "description": "事实句。禁止出现「危机」「适合合作」。"
    },
    "level_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label"
      ],
      "properties": {
        "level": {
          "$ref": "#/definitions/health_level"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "text"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{1,2}:[0-9]{2}$",
          "description": "MM:SS 展示时间戳（夹具格式）。"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "like_count_display"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "like_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "like_count_display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_id",
        "platform",
        "url",
        "title",
        "channel_name",
        "duration_seconds",
        "duration_display"
      ],
      "properties": {
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "platform": {
          "type": "string",
          "const": "youtube"
        },
        "url": {
          "type": "string",
          "minLength": 8
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "channel_name": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "duration_display": {
          "type": "string",
          "minLength": 1,
          "description": "MM:SS 或 H:MM:SS"
        },
        "channel_id": {
          "type": "string"
        },
        "subscriber_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "blogger_tier": {
          "type": "string",
          "description": "素人|小博主|腰部博主|头部博主，或空"
        },
        "language": {
          "type": "string",
          "description": "主语言标签，如 中文/英语/日语；未知可为空串"
        },
        "format_kind": {
          "type": "string",
          "description": "short | video；未知可为空串"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cache_hit",
        "video_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "analyzing",
            "completed",
            "failed",
            "cache_hit"
          ]
        },
        "cache_hit": {
          "type": "boolean"
        },
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_level",
        "overall_label",
        "source",
        "llm",
        "notes",
        "transcript",
        "comments"
      ],
      "properties": {
        "overall_level": {
          "$ref": "#/definitions/health_level"
        },
        "overall_label": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/definitions/level_label"
        },
        "llm": {
          "$ref": "#/definitions/level_label"
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transcript": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "mode"
          ],
          "properties": {
            "status": {
              "$ref": "#/definitions/pipeline_status"
            },
            "mode": {
              "$ref": "#/definitions/transcript_mode"
            },
            "coverage_ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "fetched_count",
            "is_partial"
          ],
          "properties": {
            "status": {
              "$ref": "#/definitions/pipeline_status"
            },
            "fetched_count": {
              "type": "integer",
              "minimum": 0
            },
            "platform_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "is_partial": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "contrast_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_tags",
        "fetched_at_label"
      ],
      "properties": {
        "content_says": {
          "$ref": "#/definitions/no_verdict"
        },
        "comments_reply": {
          "$ref": "#/definitions/no_verdict"
        },
        "contrast_sentence": {
          "$ref": "#/definitions/no_verdict"
        },
        "freshness_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fetched_at_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_count",
        "view_count_display",
        "like_count",
        "like_count_display",
        "comment_count_fetched",
        "comment_count_display",
        "comment_count_unit",
        "published_ago_days",
        "published_ago_display",
        "duration_seconds",
        "duration_display"
      ],
      "properties": {
        "view_count": {
          "type": "integer",
          "minimum": 0
        },
        "view_count_display": {
          "type": "string",
          "minLength": 1
        },
        "like_count": {
          "type": "integer",
          "minimum": 0
        },
        "like_count_display": {
          "type": "string",
          "minLength": 1
        },
        "comment_count_fetched": {
          "type": "integer",
          "minimum": 0
        },
        "comment_count_display": {
          "type": "string",
          "minLength": 1
        },
        "comment_count_unit": {
          "type": "string",
          "minLength": 1
        },
        "published_ago_days": {
          "type": "number",
          "minimum": 0
        },
        "published_ago_display": {
          "type": "string",
          "minLength": 1
        },
        "published_ago_note": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "duration_display": {
          "type": "string",
          "minLength": 1
        },
        "duration_note": {
          "type": "string",
          "description": "六卡副文案，不是 video_type，禁止当卖点类目或类型字段。"
        },
        "engagement_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "engagement_ratio_display": {
          "type": "string"
        },
        "engagement_ratio_note": {
          "type": "string"
        },
        "platform_comment_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "confidence",
        "summary",
        "cta_type",
        "ad_overlay",
        "captions"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/segment_kind"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "cta_type": {
          "$ref": "#/definitions/cta_type"
        },
        "ad_overlay": {
          "type": [
            "string",
            "null"
          ],
          "description": "可选植入事实描述。无则 null。禁止空广告卡，禁止第四段 kind=广告。"
        },
        "captions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/caption"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "收束"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {},
      "else": {
        "properties": {
          "cta_type": {
            "type": "null"
          }
        }
      }
    },
    "content_conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_types",
        "topics",
        "thesis",
        "tone",
        "tone_description",
        "commercial",
        "confidence",
        "coverage_label"
      ],
      "properties": {
        "video_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/video_type"
          }
        },
        "topics": {
          "type": "array",
          "maxItems": 3,
          "description": "题材自由词 1–3 个短中文（非枚举）。缺失由管线填 []。不可作主聚合键。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "thesis": {
          "$ref": "#/definitions/no_verdict"
        },
        "tone": {
          "$ref": "#/definitions/tone"
        },
        "tone_description": {
          "type": "string",
          "minLength": 1
        },
        "commercial": {
          "type": [
            "string",
            "null"
          ],
          "description": "商业事实句。无植入必须为 JSON null。禁止字段名 selling_points / 卖点。禁止空串「无卖点」。"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "coverage_label": {
          "type": "string",
          "minLength": 1
        },
        "coverage_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "content_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_status",
        "segments"
      ],
      "properties": {
        "pipeline_status": {
          "$ref": "#/definitions/pipeline_status"
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/segment"
          }
        },
        "content_conclusion": {
          "$ref": "#/definitions/content_conclusion"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pipeline_status": {
                "const": "failed"
              }
            },
            "required": [
              "pipeline_status"
            ]
          },
          "then": {},
          "else": {
            "if": {
              "properties": {
                "skip_reason": {
                  "const": "user_skipped_stt"
                }
              },
              "required": [
                "skip_reason"
              ]
            },
            "then": {
              "required": [
                "pipeline_status",
                "segments",
                "content_conclusion",
                "skip_reason"
              ],
              "properties": {
                "pipeline_status": {
                  "const": "degraded"
                },
                "skip_reason": {
                  "const": "user_skipped_stt"
                },
                "segments": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "required": [
                "pipeline_status",
                "segments",
                "content_conclusion"
              ],
              "properties": {
                "segments": {
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      ]
    },
    "reaction_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "display_label",
        "count",
        "examples"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/reaction_type"
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "theme_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "examples"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "weight": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "comment_conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doing",
        "themes",
        "alignment",
        "confidence",
        "sample_label",
        "sample_fetched"
      ],
      "properties": {
        "doing": {
          "$ref": "#/definitions/no_verdict"
        },
        "themes": {
          "$ref": "#/definitions/no_verdict"
        },
        "alignment": {
          "$ref": "#/definitions/no_verdict"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "sample_label": {
          "type": "string",
          "minLength": 1
        },
        "sample_fetched": {
          "type": "integer",
          "minimum": 0
        },
        "sample_platform_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sample_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "low_confidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "confidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/definitions/low_confidence"
        }
      }
    },
    "human_review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "待确认"
        }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filtered_count",
        "filtered_ratio",
        "label"
      ],
      "properties": {
        "filtered_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reply_heat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_in_sentiment"
      ],
      "properties": {
        "reply_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "included_in_sentiment": {
          "type": "boolean",
          "const": false,
          "description": "回复只计热度，禁止混入情感分母。若本对象出现，本字段必须为 false。"
        }
      }
    },
    "comment_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_status",
        "low_confidence_items",
        "human_review_items",
        "noise"
      ],
      "properties": {
        "pipeline_status": {
          "$ref": "#/definitions/pipeline_status"
        },
        "sentiment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive_pct",
            "neutral_pct",
            "negative_pct"
          ],
          "properties": {
            "positive_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "neutral_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "negative_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "reaction_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reaction_bucket"
          }
        },
        "open_themes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/theme_bucket"
          }
        },
        "top_positive_quote": {
          "$ref": "#/definitions/quote"
        },
        "top_negative_quote": {
          "$ref": "#/definitions/quote"
        },
        "sentiment_examples": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "正面",
            "中性",
            "负面"
          ],
          "properties": {
            "正面": {
              "type": "array",
